# Shared defaults for all IDF targets (esp32 / esp32s3).
# Target-specific overrides: sdkconfig.defaults.esp32, sdkconfig.defaults.esp32s3
# Build with: ./scripts/lumos_idf.sh esp32 build   or   ./scripts/lumos_idf.sh esp32s3 build

# Flash / partitions (size may be overridden per-target)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# C++
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# WiFi
CONFIG_ESP_WIFI_SOFTAP_BEACON_MAX_LEN=752
CONFIG_LWIP_MAX_SOCKETS=16

# mDNS
CONFIG_MDNS_MAX_SERVICES=10

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# Main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# LED strip / RMT
CONFIG_RMT_SUPPRESS_DEPRECATE_WARN=y

# Matter / Bluetooth deferred — re-enable with lumos_matter bring-up
# CONFIG_BT_ENABLED is not set
